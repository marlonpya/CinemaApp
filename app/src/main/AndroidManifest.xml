<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyAppZegel">

        <!-- ══════════════════════════════════════════════════════
             MVVM — launcher principal
             ══════════════════════════════════════════════════════ -->
        <activity
            android:name=".presentation.mvvm.home.HomeActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.mvvm.moviedetail.MovieDetailActivity"
            android:exported="false"
            android:parentActivityName=".presentation.mvvm.home.HomeActivity" />

        <activity
            android:name=".presentation.mvvm.fooddetail.FoodDetailActivity"
            android:exported="false"
            android:parentActivityName=".presentation.mvvm.home.HomeActivity" />

        <!-- ══════════════════════════════════════════════════════
             MVP — cambiar HomeMvpActivity a MAIN/LAUNCHER para probar
             ══════════════════════════════════════════════════════ -->
        <activity
            android:name=".presentation.mvp.home.HomeMvpActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.mvp.moviedetail.MovieDetailMvpActivity"
            android:exported="false"
            android:parentActivityName=".presentation.mvp.home.HomeMvpActivity" />

        <activity
            android:name=".presentation.mvp.fooddetail.FoodDetailMvpActivity"
            android:exported="false"
            android:parentActivityName=".presentation.mvp.home.HomeMvpActivity" />

    </application>

</manifest>

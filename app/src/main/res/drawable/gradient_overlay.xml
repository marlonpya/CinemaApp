<?xml version="1.0" encoding="utf-8"?>
<!-- Semi-transparent gradient overlay for detail screen header images.
     Bottom is more opaque so text/buttons remain readable. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#CC000000"
        android:startColor="#22000000"
        android:type="linear" />
</shape>
